diff --git i/src/render/animation/animation.cpp w/src/render/animation/animation.cpp
index f94e44b..8be096a 100644
--- i/src/render/animation/animation.cpp
+++ w/src/render/animation/animation.cpp
@@ -1,6 +1,7 @@
 #include "render/animation/animation.h"
 
 #include <algorithm>
+#include <cmath>
 
 float applyEasing(Easing easing, float t) {
   t = std::clamp(t, 0.0F, 1.0F);
@@ -40,6 +41,27 @@ float applyEasing(Easing easing, float t) {
     const float f = t - 1.0F;
     return 1.0F + c3 * f * f * f + c1 * f * f;
   }
+
+  case Easing::EaseOutWater: {
+  // Spring bem macia, tipo balão de água:
+  // wobble amplo, overshoot suave e assentamento progressivo.
+  constexpr float damping = 4.0F;
+  constexpr float frequency = 11.0F;
+  constexpr float softness = 0.50F;
+
+  const float e = std::exp(-damping * t);
+  const float w = frequency;
+
+  const float spring =
+      1.0F
+      - e * (
+          std::cos(w * t)
+          + (damping / w) * std::sin(w * t)
+      );
+
+  // Mantém a trajetória base e reduz a força da spring em 50%.
+  return t + (spring - t) * softness;
+}
   }
 
   return t;
